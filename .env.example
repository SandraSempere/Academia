# Copia este archivo a .env (local) o configura estas mismas variables en el
# panel de tu hosting (producción). Nunca subas .env real al repositorio.

# En local: "file:./dev.db" (archivo junto al proyecto).
# En producción: ruta dentro del volumen persistente, p.ej. "file:/data/prod.db"
# — si no vive en un volumen, se pierde la base de datos en cada despliegue.
DATABASE_URL="file:./dev.db"

# Firma las sesiones de login. Genera uno distinto para producción con:
# openssl rand -base64 32
AUTH_SECRET=""

# Necesario en producción cuando la app NO está en Vercel (Auth.js solo se
# fía del host de la petición si se lo dices explícitamente).
AUTH_TRUST_HOST="true"

# El dominio real de la app en producción (https://app.sandrasempere.com) —
# sin esto, Auth.js puede calcular mal alguna URL interna (p.ej. a dónde
# vuelves tras cerrar sesión) y usar su valor de repuesto por defecto
# (localhost:3000) en vez del dominio real. No hace falta en local.
AUTH_URL="https://app.sandrasempere.com"

# URL base real de la app — se usa para construir el enlace de "restablecer
# contraseña" que se manda por email. En local: http://localhost:3000. En
# producción: el dominio real, p.ej. https://app.sandrasempere.com
APP_URL="http://localhost:3000"

# Protege /api/cron/form-reminders, /api/cron/appointment-reminders y
# /api/cron/plan-file-digest para que solo los pueda llamar tu propio cron
# (no cualquiera que adivine la URL). Genera uno con:
# openssl rand -hex 16
# Las tareas programadas deben llamar a la URL añadiendo ?secret=ESTE_VALOR
# — necesitas un Cron Job de Railway por cada una: "Recordatorio pacientes"
# (form-reminders, ya existente), "Recordatorio citas" (appointment-
# reminders) programado a las 9:00 para que el aviso del mismo día de la
# cita llegue justo a esa hora, y "Email plan combinado" (plan-file-digest)
# programado cada 5 minutos (`*/5 * * * *`) — junta en un único email los
# documentos de plan que subas seguidos para la misma paciente en vez de
# mandar uno por archivo.
CRON_SECRET=""

# Envío de emails (bienvenida a pacientes, recordatorios, avisos a la
# coach, restablecer contraseña) vía la API HTTP de Resend — no SMTP
# directo, porque muchos hostings (Railway incluido, en el plan Hobby)
# bloquean las conexiones SMTP salientes. Clave API en resend.com, y
# EMAIL_FROM debe ser una dirección del dominio que hayas verificado ahí
# (no hace falta que sea un buzón real).
RESEND_API_KEY=""
EMAIL_FROM=""
# A quién le llegan los avisos a la coach (formulario de síntomas, revisión
# quincenal, cierre) — puede ser cualquier email normal, no hace falta que
# sea del dominio verificado.
EMAIL_TO=""

# Webhook de Resend (/api/webhooks/resend) — para saber en el historial de
# avisos de cada paciente (`/coach/pacientes/[id]`) si un email se entregó
# de verdad, se abrió, rebotó o se marcó como spam (no solo si Resend lo
# aceptó al mandarlo, que es lo único que se sabe sin esto). Pasos en
# resend.com:
# 1. Settings → Webhooks → Add Webhook, URL:
#    https://app.sandrasempere.com/api/webhooks/resend
#    Eventos a marcar: email.delivered, email.opened, email.bounced,
#    email.complained
# 2. Copia el "Signing Secret" que te da (empieza por "whsec_") en esta
#    variable.
# 3. Settings → tu dominio → activa "Open Tracking" — sin esto Resend nunca
#    manda el evento email.opened (necesita insertar un píxel invisible en
#    el email, que solo hace si está activado).
RESEND_WEBHOOK_SECRET=""

# Copia de seguridad automática en Google Drive (OAuth). Credenciales creadas
# en Google Cloud Console. El "redirect URI" debe coincidir exactamente con
# el que hayas dado de alta en Google Cloud (cambia a tu dominio real en
# producción, p.ej. https://app.sandrasempere.com/api/backup/callback).
GOOGLE_OAUTH_CLIENT_ID=""
GOOGLE_OAUTH_CLIENT_SECRET=""
GOOGLE_OAUTH_REDIRECT_URI="http://localhost:3000/api/backup/callback"

# Google Sheet donde se añade una fila (nombre, apellidos, teléfono, email,
# ciudad, provincia, país) cada vez que una paciente envía por primera vez
# el Formulario de síntomas. Usa la misma conexión de Google que la Copia
# de seguridad de arriba. Es el ID que va en la URL de la hoja, entre
# /d/ y /edit — p.ej. en
# https://docs.google.com/spreadsheets/d/ESTE_TROZO/edit
PATIENTS_SHEET_ID=""

# Notificaciones push del navegador (Web Push) a las pacientes. Genera el
# par de claves una sola vez con:
# npx web-push generate-vapid-keys
# La pública lleva NEXT_PUBLIC_ porque también la necesita el navegador
# (va en el JS que se descarga la paciente); la privada nunca debe salir
# del servidor. VAPID_SUBJECT es solo un email/URL de contacto que exige el
# estándar Web Push, no se le muestra a nadie.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:academia@sandrasempere.com"
