# Copia este archivo a .env (local) o configura estas mismas variables en el
# panel de tu hosting (producción). Nunca subas .env real al repositorio.

# En local: "file:./dev.db" (archivo junto al proyecto).
# En producción: ruta dentro del volumen persistente, p.ej. "file:/data/prod.db"
# — si no vive en un volumen, se pierde la base de datos en cada despliegue.
DATABASE_URL="file:./dev.db"

# Firma las sesiones de login. Genera uno distinto para producción con:
# openssl rand -base64 32
AUTH_SECRET=""

# Necesario en producción cuando la app NO está en Vercel (Auth.js solo se
# fía del host de la petición si se lo dices explícitamente).
AUTH_TRUST_HOST="true"

# URL base real de la app — se usa para construir el enlace de "restablecer
# contraseña" que se manda por email. En local: http://localhost:3000. En
# producción: el dominio real, p.ej. https://app.sandrasempere.com
APP_URL="http://localhost:3000"

# Protege /api/cron/form-reminders para que solo lo pueda llamar tu propio
# cron (no cualquiera que adivine la URL). Genera uno con:
# openssl rand -hex 16
# La tarea programada debe llamar a la URL añadiendo ?secret=ESTE_VALOR
CRON_SECRET=""

# Envío de emails (bienvenida a pacientes, recordatorios, avisos a la
# coach, restablecer contraseña) vía la API HTTP de Resend — no SMTP
# directo, porque muchos hostings (Railway incluido, en el plan Hobby)
# bloquean las conexiones SMTP salientes. Clave API en resend.com, y
# EMAIL_FROM debe ser una dirección del dominio que hayas verificado ahí
# (no hace falta que sea un buzón real).
RESEND_API_KEY=""
EMAIL_FROM=""
# A quién le llegan los avisos a la coach (formulario de síntomas, revisión
# quincenal, cierre) — puede ser cualquier email normal, no hace falta que
# sea del dominio verificado.
EMAIL_TO=""

# Copia de seguridad automática en Google Drive (OAuth). Credenciales creadas
# en Google Cloud Console. El "redirect URI" debe coincidir exactamente con
# el que hayas dado de alta en Google Cloud (cambia a tu dominio real en
# producción, p.ej. https://app.sandrasempere.com/api/backup/callback).
GOOGLE_OAUTH_CLIENT_ID=""
GOOGLE_OAUTH_CLIENT_SECRET=""
GOOGLE_OAUTH_REDIRECT_URI="http://localhost:3000/api/backup/callback"

# Google Sheet donde se añade una fila (nombre, apellidos, teléfono, email,
# ciudad, provincia, país) cada vez que una paciente envía por primera vez
# el Formulario de síntomas. Usa la misma conexión de Google que la Copia
# de seguridad de arriba. Es el ID que va en la URL de la hoja, entre
# /d/ y /edit — p.ej. en
# https://docs.google.com/spreadsheets/d/ESTE_TROZO/edit
PATIENTS_SHEET_ID=""
